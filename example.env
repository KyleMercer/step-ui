# Step-CA Configuration
CA_URL=https://ca.home:9000
PROVISIONER_NAME=ui-admin
PROVISIONER_PASSWORD=your-provisioner-password-here

# Application Configuration
DB_PATH=./data/certs.db
PORT=8080

# Frontend Configuration
