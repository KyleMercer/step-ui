# Step-CA Configuration
CA_URL=https://ca.home:9000
CA_ROOT_FINGERPRINT=your-ca-root-fingerprint-here
PROVISIONER_NAME=ui-admin
PROVISIONER_PASSWORD=your-provisioner-password-here

# Application Configuration
DB_PATH=./data/certs.db
PORT=8080

# Security (both optional, but recommended for anything reachable beyond
# localhost -- see the README's Security Notes section)
#
# API_AUTH_TOKEN: if set, every /api/* request to the backend must send it
# as `Authorization: Bearer <token>`. Generate one with, e.g.:
#   openssl rand -hex 32
# Leave blank to leave the API unauthenticated (the previous behavior).
# NOTE: the frontend needs the SAME value in NEXT_PUBLIC_API_AUTH_TOKEN
# below to keep working. Like NEXT_PUBLIC_API_URL, this is a genuine
# runtime variable -- changing it and recreating the frontend container is
# enough, no rebuild required (frontend/docker-entrypoint.sh substitutes
# it in at container start). It's also shipped in the frontend's
# client-side JS bundle, so treat it as a shared secret between the two
# containers, not as real user authentication.
API_AUTH_TOKEN=
# CORS_ALLOWED_ORIGIN: the one origin the backend accepts browser requests
# from. Defaults to http://localhost:3000 if unset; change this if you
# access the frontend at a different host/port.
CORS_ALLOWED_ORIGIN=http://localhost:3000

# User accounts: step-ui now requires signing in (separate from
# API_AUTH_TOKEN above, which is a container-to-container shared secret, not
# a real login). There's no self-registration -- accounts are created and
# managed by an admin from the Settings page once logged in. These two
# variables exist only to create the very first admin account: they're
# checked ONCE, only if the user accounts table is completely empty. Once
# any account exists (including right after this first boot), these
# variables are ignored on every subsequent start -- safe to leave them set
# or blank them out afterwards. If the table is empty and these are unset,
# the backend logs a startup warning and nobody can log in until you set
# them and restart.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# Single sign-on (OIDC) -- optional. Off unless OIDC_ISSUER_URL,
# OIDC_CLIENT_ID, OIDC_CLIENT_SECRET and OIDC_REDIRECT_URL are ALL set. The
# local username/password login keeps working either way. See the README's
# "Single Sign-On (OIDC)" section for the Authentik setup.
#
# OIDC_ISSUER_URL: must match the provider's issuer exactly, trailing slash
# included. Authentik: https://<authentik-host>/application/o/<app-slug>/
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL: the BACKEND's callback as the browser reaches it
# (through your reverse proxy). Register exactly this at the provider.
#   e.g. https://step-ui-api.example.com:8443/api/auth/oidc/callback
OIDC_REDIRECT_URL=
# Group names (case-sensitive) that grant each role, re-checked at every
# sign-in. Admin wins if someone is in both. Anyone in neither is refused.
OIDC_ADMIN_GROUP=stepui-admins
OIDC_VIEWER_GROUP=stepui-viewers
# Label for the login button ("Sign in with <name>").
OIDC_PROVIDER_NAME=Authentik
# Optional, rarely needed (defaults shown):
#   OIDC_GROUPS_CLAIM=groups
#   OIDC_USERNAME_CLAIM=preferred_username
#   OIDC_SCOPES=openid profile email
# OIDC_CA_FILE: path INSIDE the backend container to a PEM file of extra CA
# certificates to trust when talking to the provider. Only needed if the
# provider's certificate isn't publicly trusted (e.g. issued by step-ca).
OIDC_CA_FILE=

# Frontend Configuration
# Both of these are genuine runtime variables -- changing either one and
# recreating the frontend container (docker compose up -d, or Dockhand's
# "save and redeploy"/"force recreate") is enough. No rebuild required.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_API_AUTH_TOKEN=
